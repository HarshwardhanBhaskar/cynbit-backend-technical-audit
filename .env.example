# Environment Configuration Template
# Copy this file to .env and configure for your local/production environment
# NEVER commit .env to version control

# --- Application Settings ---
APP_NAME="Cynbit Backend Reference API"
APP_ENV=development
DEBUG=false
API_V1_PREFIX="/api/v1"
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-in-production

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000
WORKERS=4

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cynbit_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# --- SQLite (Alternative for local tests / development) ---
# DATABASE_URL=sqlite+aiosqlite:///./cynbit_local.db

# --- Redis (Caching & Rate Limiting) ---
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5

# --- Security & JWT Settings ---
JWT_SECRET_KEY=generate-a-strong-jwt-secret-key-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS Settings (comma-separated list of allowed origins) ---
CORS_ORIGINS=https://cynbit.in,https://www.cynbit.in,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL=60/minute
RATE_LIMIT_APPLICATION=5/hour
RATE_LIMIT_CONTACT=5/hour
RATE_LIMIT_AUTH=5/15minute

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- AI Automation / OpenAI (Optional for ai-automation deliverable) ---
OPENAI_API_KEY=sk-placeholder-openai-api-key-here
AI_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=0.75
